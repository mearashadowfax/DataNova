---
/**
 * One mega menu, rendered from a `Menu` in `src/navigation.ts`.
 * `list` menus show icon + title + description per link; `cards` menus show an
 * image per link. Active state follows `menu.pathPrefix`.
 */
import { Image } from 'astro:assets';
import Icon from '@ui/icons/Icon.astro';
import { menuItems, type Menu } from '@/navigation';

interface Props {
  menu: Menu;
}

const { menu } = Astro.props;
const buttonId = `mega-menu-${menu.id}`;
const isActive =
  menu.pathPrefix !== undefined &&
  Astro.url.pathname.startsWith(menu.pathPrefix);
---

<div
  class="hs-dropdown [--adaptive:none] [--is-collapse:true] [--strategy:static] xl:[--is-collapse:false] xl:[--strategy:absolute] xl:[--trigger:hover]"
>
  <button
    id={buttonId}
    type="button"
    class:list={[
      'hs-dropdown-toggle flex w-full items-center rounded-lg p-2 font-medium text-nowrap text-slate-800 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden',
      isActive && 'underline underline-offset-4',
    ]}
    aria-haspopup="menu"
    aria-expanded="false"
    aria-label={menu.label}
  >
    {menu.label}
    <Icon name="arrowDownRight" />
  </button>

  <div
    class="hs-dropdown-menu hs-dropdown-open:opacity-100 relative start-0 top-full z-10 mt-2 hidden w-full max-w-(--breakpoint-md) min-w-60 opacity-0 transition-[opacity,margin] duration-150 before:absolute before:start-0 before:-top-5 before:h-5 before:w-full xl:left-1/2 xl:-translate-x-1/2 xl:duration-300"
    role="menu"
    aria-orientation="vertical"
    aria-labelledby={buttonId}
  >
    <div
      class="from-teal-100 via-transparent to-white px-4 py-2 lg:mx-8 xl:mx-6 xl:rounded-lg xl:bg-white xl:bg-linear-to-t/oklch xl:px-16 xl:py-10 xl:shadow-lg xl:ring-1 xl:ring-teal-950/5"
    >
      {
        menu.description && (
          <>
            <p class="text-sm text-slate-600">{menu.description}</p>
            <hr class="mb-5 border border-teal-300" />
          </>
        )
      }

      {
        menu.layout === 'cards' ? (
          <div class="grid grid-cols-1 gap-4 py-1 sm:grid-cols-2 xl:grid-cols-3 xl:p-2 2xl:grid-cols-2">
            {menuItems(menu).map(item => (
              <div class="flex h-full flex-col">
                <a
                  class="group flex h-full flex-col rounded-lg p-3 transition hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden"
                  href={item.href}
                >
                  <Image
                    class="aspect-video w-full rounded-xl object-cover transition-transform duration-500 ease-in-out group-hover:scale-105 group-focus:scale-105"
                    src={item.image}
                    alt={item.title}
                  />
                  <div class="mt-5 flex flex-1 flex-col">
                    <h3 class="text-sm font-medium text-slate-800">
                      {item.title}
                    </h3>
                    <p class="mt-3 text-sm text-slate-500 xl:hidden 2xl:block">
                      {item.description}
                    </p>
                  </div>
                </a>
              </div>
            ))}
          </div>
        ) : (
          <div class="gap-4 py-1 md:grid md:grid-cols-2 md:p-2">
            {menu.sections.map(section => (
              <div class="flex flex-col">
                {section.title && (
                  <p class="text-sm text-slate-600">{section.title}</p>
                )}

                {section.items.map(item => (
                  <a
                    class="flex gap-x-4 rounded-lg p-3 hover:bg-slate-100 focus:bg-slate-100 focus:outline-hidden"
                    href={item.href}
                  >
                    <Icon
                      name={item.icon}
                      class="mt-1 size-5 shrink-0 text-slate-800"
                    />
                    <div class="grow">
                      <p class="text-sm font-medium text-slate-800">
                        {item.title}
                      </p>
                      <p class="text-sm text-slate-500">{item.description}</p>
                    </div>
                  </a>
                ))}
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</div>
