---
import Icon from '@ui/icons/Icon.astro';
import { site, telHref } from '@/site';

const { name, address, phone, email, website } = site;
---

<div>
  <h3 class="font-semibold text-slate-700">Contact us</h3>
  <ul class="mt-3 space-y-2 text-sm text-slate-600">
    <li>{name}</li>
    <li>{address.city}</li>
    <li class="flex items-center gap-x-2">
      <Icon name="mobile" />
      <a
        href={telHref(phone)}
        class="transition-colors duration-300 hover:text-slate-500"
      >
        {phone}
      </a>
    </li>
    <li class="flex items-center gap-x-2">
      <Icon name="email" />
      <a
        href={'mailto:' + email}
        class="transition-colors duration-300 hover:text-slate-500"
      >
        {email}
      </a>
    </li>
    <li class="flex items-center gap-x-2">
      <Icon name="world" />
      <a
        href={'https://' + website}
        class="transition-colors duration-300 hover:text-slate-500"
      >
        {website}
      </a>
    </li>
  </ul>
</div>
