---
/**
 * Lists every document in a doc collection, newest first.
 */
import BaseLayout from '@layout/BaseLayout.astro';
import EmptyState from '@common/EmptyState.astro';
import Breadcrumbs from '@common/Breadcrumbs.astro';
import { supportTrail } from '@/navigation';
import { docCollections, type DocCollection } from '@/support/docs';
import { listDocs } from '@/support/load';

interface Props {
  collection: DocCollection;
}

const { collection } = Astro.props;
const { label, basePath, empty } = docCollections[collection];
const docs = await listDocs(collection);
const actionLabel = 'Read more';

const seo = {
  title: `${label} - DataNova`,
  description: `Browse DataNova ${label.toLowerCase()}.`,
};
---

<BaseLayout seo={seo}>
  <section class="bg-linear-to-br/oklch from-teal-200 via-transparent to-white">
    <div class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
      <div class="max-w-7xl">
        <div class="mx-auto max-w-3xl lg:mx-0">
          <Breadcrumbs items={supportTrail({ label })} />
          <h1 class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">
            {label}
          </h1>
        </div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
    <div class="grid grid-cols-1 items-center lg:grid-cols-3">
      {docs.length === 0 ? (
        <EmptyState
          title={empty.title}
          description={empty.description}
          actionHref="/contact"
          actionLabel="Contact us"
        />
      ) : (
        docs.map((item, index) => {
          const totalItems = docs.length;
          const itemsPerRow = 3;

          const isLastRow =
            Math.floor(index / itemsPerRow) ===
            Math.floor((totalItems - 1) / itemsPerRow);

          const borderClasses = isLastRow
            ? index % 3 === 0
              ? 'border-none'
              : index % 3 === 1
                ? 'lg:border-x'
                : ''
            : index % 3 === 0
              ? 'border-b'
              : index % 3 === 1
                ? 'border-b lg:border-x '
                : 'border-b';

          return (
            <a
              class={`card group ${borderClasses}`}
              href={`${basePath}/${item.id}`}
            >
              <div class="mb-5">
                <div class="mt-5">
                  <h3 class="mt-5 text-lg font-medium text-slate-800">
                    {item.data.title}
                  </h3>
                  <p class="mt-1 text-slate-500">{item.data.description}</p>
                </div>
              </div>
              <p class="mt-auto">
                <span class="border-b-2 border-slate-500 pb-1 text-sm font-medium text-slate-700 transition duration-300 group-hover:border-teal-500 group-focus:border-teal-500 focus:outline-hidden">
                  {actionLabel}
                </span>
              </p>
            </a>
          );
        })
      )}
    </div>
  </section>
</BaseLayout>
