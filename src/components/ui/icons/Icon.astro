---
import type { HTMLAttributes } from 'astro/types';
import { Icons, type IconName } from './icons.ts';

interface Path {
  d: string;
  class?: string;
}

interface Props extends HTMLAttributes<'svg'> {
  /** A key of `Icons`; a typo is a type error at every call site. */
  name: IconName;
}

const { name, class: className, ...attributes } = Astro.props;
const icon = Icons[name] as {
  paths: Path[];
  class?: string;
  title?: string;
  viewBox?: string;
  fill?: string;
  stroke?: string;
  strokeWidth?: astroHTML.JSX.SVGAttributes['stroke-width'];
  strokeLinecap?: astroHTML.JSX.SVGAttributes['stroke-linecap'];
  strokeLinejoin?: astroHTML.JSX.SVGAttributes['stroke-linejoin'];
};
const paths: Path[] = icon.paths;

const combinedClass = [icon.class, className].filter(Boolean).join(' ');
const ariaHidden = attributes['aria-hidden'];
---

{
  (
    <svg
      {...attributes}
      class={combinedClass}
      viewBox={icon.viewBox}
      fill={icon.fill}
      stroke={icon.stroke}
      stroke-width={icon.strokeWidth}
      stroke-linecap={icon.strokeLinecap}
      stroke-linejoin={icon.strokeLinejoin}
      aria-hidden={ariaHidden ?? (!icon.title ? 'true' : undefined)}
    >
      {icon.title && !ariaHidden ? <title>{icon.title}</title> : null}
      {paths.map((path: Path) => (
        <path d={path.d} class={path.class || ''} />
      ))}
    </svg>
  )
}
