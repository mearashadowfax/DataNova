---
import SupportPage from '@/components/support/SupportPage.astro';
import Icon from '@ui/icons/Icon.astro';
import { getCollection } from 'astro:content';
import { isLastRow } from '@utils/grid';

const whitepapers = await getCollection('whitepapers');
const perRow = 2;
const actionLabel = 'Read more';
---

<SupportPage resource="whitepapers" count={whitepapers.length}>
  <div class="grid grid-cols-1 sm:grid-cols-2">
    {
      whitepapers.map((paper, index) => {
        const borderRight = index % perRow === 0 ? 'sm:border-r' : '';
        const borderBottom = isLastRow(index, whitepapers.length, perRow)
          ? ''
          : 'border-b';

        return (
          <div
            class={`border-dashed border-slate-300 p-6 ${borderRight} ${borderBottom} flex flex-col justify-between`}
          >
            <div>
              <h2 class="text-lg font-semibold text-slate-700">
                {paper.data.title}
              </h2>
              <p class="mt-4 text-slate-700">{paper.data.description}</p>
            </div>
            <div class="mt-auto">
              {paper.data.readLink && (
                <a
                  href={paper.data.readLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group mt-6 mr-6 inline-flex items-center border-b-2 border-slate-500 pb-1 text-sm font-medium text-slate-700 transition-colors duration-300 hover:border-teal-500 hover:text-slate-500 focus:ring-2 focus:ring-teal-400 focus:outline-hidden"
                >
                  {actionLabel}
                  <span class="sr-only"> (opens in a new tab)</span>
                  <Icon
                    name="newWindow"
                    class="ms-2 size-4 text-slate-900 transition duration-300 group-hover:text-slate-600"
                    aria-hidden="true"
                  />
                </a>
              )}
              {paper.data.btnLink && (
                <a
                  href={paper.data.btnLink}
                  download
                  class="mt-6 inline-flex items-center rounded-md bg-teal-700 px-4 py-2 text-sm font-medium text-white shadow-xs transition-colors duration-300 hover:bg-teal-700/80 focus:ring-2 focus:ring-teal-400 focus:outline-hidden"
                >
                  {paper.data.btnTitle}
                </a>
              )}
            </div>
          </div>
        );
      })
    }
  </div>
</SupportPage>
