---
import DocPage from '@/components/support/DocPage.astro';
import { docPaths, loadDoc, type DocEntry } from '@/support/load';

export const getStaticPaths = () => docPaths('reference');

interface Props {
  entry: DocEntry;
}

const doc = await loadDoc(Astro.props.entry, Astro.url);
---

<DocPage doc={doc} />
