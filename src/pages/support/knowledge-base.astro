---
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@common/PageHero.astro';
import { describePage } from '@/seo';

const title = 'Knowledge Base';
const content =
  "Still building our knowledge hub! While we're constantly adding new resources and documentation, some topics might not be covered yet. If you can't find what you're looking for, reach out to our team – we'll get you answers fast and make sure you have the support you need.";

const page = describePage({
  title,
  description: content,
  url: Astro.url,
});
---

<BaseLayout page={page}>
  <PageHero title={title} subtitle={content} gradient="br" width="3xl" />
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
  </section>
</BaseLayout>
