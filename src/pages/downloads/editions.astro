---
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@common/PageHero.astro';
import Icon from '@ui/icons/Icon.astro';
import { describePage } from '@/seo';
import { editionList, product } from '@/product';

const { essential, advanced } = product.editions;

const title = `${essential.name} and ${advanced.name}`;
const description = [
  product.intro,
  `<strong>${essential.name}</strong> – ${essential.blurb}`,
  `<strong>${advanced.name}</strong> – ${advanced.blurb}`,
];

const page = describePage({
  title,
  description: product.intro,
  url: Astro.url,
});

// Page copy
const strings = {
  preTitle: 'Editions',
  systemRequirements: 'System Requirements',
  trialInfo: `A ${product.trial.days}-day free trial is available for each edition, with no commitment required.`,
  download: (edition: string) => `Download the ${edition}`,
};
const buttonStyles = {
  essential:
    'bg-teal-50 hover:bg-teal-50/70 text-slate-800 focus:bg-teal-50/70',
  advanced: 'bg-teal-600 text-white hover:bg-teal-600/80 focus:bg-teal-600/80',
};
---

<BaseLayout page={page}>
  <PageHero
    preTitle={strings.preTitle}
    title={title}
    subtitle={description}
    gradient="tl"
  />

  <section class="bg-linear-to-bl/oklch from-teal-200 via-transparent to-white">
    <div
      class="relative mx-auto max-w-[60rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14"
    >
      <div class="hidden py-2 md:block">
        <div class="grid grid-cols-4 gap-6">
          {
            editionList.map((edition, index) => (
              <div
                class:list={[
                  'col-span-1 mx-auto',
                  index === 0 && 'col-start-3',
                ]}
              >
                <h3 class="text-center text-lg font-medium text-slate-800">
                  {edition.name}
                </h3>
              </div>
            ))
          }
        </div>
      </div>

      <div class="space-y-4 md:space-y-0">
        {
          product.comparison.map(row => (
            <ul class="grid md:grid-cols-4 md:gap-6">
              <li class="pb-1.5 md:col-span-2 md:py-3">
                <span class="flex items-center font-medium text-slate-700 md:font-normal">
                  {row.href ? (
                    <a
                      href={row.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="transition-color group inline-flex items-center gap-x-1 duration-300 hover:text-slate-500"
                    >
                      {row.feature}{' '}
                      <Icon
                        name="info"
                        class="transition-color size-5 shrink-0 text-slate-800 duration-300 group-hover:text-slate-500"
                      />
                    </a>
                  ) : (
                    row.feature
                  )}
                </span>
              </li>

              {editionList.map(edition => {
                const included = row.includedIn.includes(edition.id);
                return (
                  <li class="col-span-1 border-b border-slate-200 py-1.5 md:py-3">
                    <div class="grid grid-cols-2 sm:grid-cols-4 md:flex">
                      <span class="self-end text-slate-500 sm:col-span-2 md:hidden">
                        {edition.name}
                      </span>
                      <span class="place-self-center md:mx-auto">
                        <span class="inline-flex items-center">
                          <Icon
                            name={included ? 'check' : 'minus'}
                            class:list={[
                              'size-5 shrink-0',
                              included ? 'text-teal-700' : 'text-slate-400',
                            ]}
                            aria-hidden="true"
                          />
                          <span class="sr-only">
                            {included ? 'Included' : 'Not included'}
                          </span>
                        </span>
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          ))
        }
      </div>
    </div>
  </section>
  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="grid divide-y divide-dashed divide-slate-400 rounded-3xl bg-teal-300 px-5 py-5 shadow-xl lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
      <div class="content-center py-5 sm:p-5">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {strings.systemRequirements}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {product.systemRequirements}
        </p>
      </div>

      <div class="py-5 sm:p-5">
        <Icon name="info" class="size-8" />

        <p class="mt-6 mb-8 text-lg/8 text-pretty text-slate-700 sm:mb-10">
          {strings.trialInfo}
        </p>

        <div class="mx-auto flex flex-col gap-4 sm:flex-row sm:justify-center">
          {
            editionList.map(edition => (
              <a
                href={edition.hrefs.download}
                class:list={[
                  'mx-auto flex w-full items-center justify-center rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold transition duration-300 focus:outline-hidden sm:w-1/2',
                  buttonStyles[edition.id],
                ]}
              >
                {strings.download(edition.name)}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
