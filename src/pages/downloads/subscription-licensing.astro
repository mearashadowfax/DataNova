---
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@common/PageHero.astro';
import Icon from '@ui/icons/Icon.astro';
import { describePage } from '@/seo';
import { site } from '@/site';
import { product } from '@/product';

const { subscription } = product;
const edition = product.editions[subscription.edition];

const title = `Subscribe to the ${edition.name} of the ${site.product}`;
const subTitle = `Access the full ${edition.name} for just ${subscription.price.amount}${subscription.price.per} with <i>no upfront costs</i> or <i>minimum license period</i>. Subscribe for as long as you need – even for <i>just one user</i>.`;

const page = describePage({
  title: 'Subscription Licensing',
  description: `Subscribe to the ${edition.name} of ${site.product} for ${subscription.price.amount}${subscription.price.per} with no upfront costs or minimum license period.`,
  url: Astro.url,
});

// Features
const features = [
  `Full ${edition.name} of ${site.product}`,
  'Low upfront cost',
  'No minimum subscription period',
  'Flexible for any number of users',
];

// Info Section
const systemRequirements = `${product.systemRequirements} ${subscription.requirements}`;
const subscriptionInfo =
  'Your subscription is renewed automatically each month, but you can cancel anytime before the next renewal date. Please note that uninstalling the Core won’t cancel your subscription – this must be done separately through your account.';

// FAQ Section
const faqSection = {
  title: 'Frequently Asked Questions',
  faqs: [
    {
      question: 'Can I Pause My Subscription?',
      answer:
        'Currently, subscriptions cannot be paused. You can cancel at any time and resubscribe whenever you’re ready without losing access to updates or support.',
    },
    {
      question: 'Is My Data Secure?',
      answer:
        'Yes, the Core does not collect or store your data. All operations are performed locally on your machine, ensuring full data privacy for your files.',
    },
    {
      question: 'Can I Get a Refund?',
      answer:
        'We currently offer refunds only under certain conditions, such as technical issues that prevent the Core from functioning as expected. Please contact us for more information.',
    },
    {
      question: 'Can I Share My Subscription with Team Members?',
      answer:
        'Each subscription is for a single-user license. If you need licenses for multiple users, we offer volume discounts – contact us for a quote.',
    },
    {
      question: `Can I try the ${site.product} before subscribing?`,
      answer: `Yes, we offer a free trial so you can explore the features of the ${edition.name} before committing to a subscription. Contact us to get started.`,
    },
  ],
};
---

<BaseLayout page={page}>
  <PageHero preTitle="Subscription Licensing" title={title} subtitle={subTitle}>
    <div
      class="mt-10 grid auto-rows-fr grid-rows-2 gap-2 sm:gap-6 md:grid-cols-2"
    >
      {
        features.map(text => (
          <div class="flex gap-x-2">
            <Icon name="checkCircle" />
            <div class="grow">
              <p class="text-slate-600">{text}</p>
            </div>
          </div>
        ))
      }
    </div>

    <a
      href={subscription.href}
      class="mt-8 block rounded-lg bg-teal-600 px-3.5 py-2.5 text-center font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-teal-600/80 focus:bg-teal-600/80 focus:outline-hidden sm:mt-10 sm:w-1/2"
    >
      Subscribe Now
    </a>
  </PageHero>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="relative grid divide-y divide-dashed divide-slate-400 overflow-hidden rounded-3xl bg-teal-300 px-5 py-5 shadow-xl md:grid-cols-2 md:divide-x md:divide-y-0"
    >
      <div class="content-center py-5 sm:p-5">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          System Requirements
        </h3>
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {systemRequirements}
        </p>
      </div>

      <div class="guilloche py-5 sm:p-5">
        <Icon name="info" class="size-8" />
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {subscriptionInfo}
        </p>
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div class="mx-auto mb-10 max-w-2xl lg:mb-14">
      <h2
        class="text-2xl font-semibold tracking-tight text-balance text-slate-800 md:text-3xl md:leading-tight"
      >
        {faqSection.title}
      </h2>
    </div>

    <div class="mx-auto max-w-2xl divide-y divide-slate-200">
      {
        faqSection.faqs.map(faq => (
          <div class="py-8 first:pt-0 last:pb-0">
            <div class="flex gap-x-5">
              <Icon name="questionMark" />

              <div class="grow">
                <h3 class="font-semibold text-slate-600 md:text-lg">
                  {faq.question}
                </h3>
                <p class="mt-1 text-slate-500">
                  <Fragment set:html={faq.answer} />
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
