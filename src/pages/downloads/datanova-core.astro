---
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@common/PageHero.astro';
import Icon from '@ui/icons/Icon.astro';
import { describePage } from '@/seo';
import { site } from '@/site';
import { product, releaseLabel } from '@/product';

const { essential, advanced } = product.editions;

const title = `Download a fully functional trial version of the ${site.product}`;
const page = describePage({
  title: `Download ${site.product}`,
  description: product.intro,
  url: Astro.url,
});

// Page copy
const strings = {
  preTitle: 'Download',
  download: (edition: string) => `Download ${edition}`,
  olderReleases: 'Older Releases',
  olderReleasesIntro: `Access older versions of ${site.product} below:`,
  systemRequirements: 'System Requirements',
  excel2003: 'Excel 2003',
  excel2003Note:
    'Excel 2003 isn’t supported. Use version 3 links below for compatibility.',
};

const infoLinks = [
  {
    text: 'View the end-user license agreement (EULA)',
    href: product.links.eula,
    download: true,
  },
  {
    text: 'Install / uninstall instructions',
    href: product.links.install,
    download: false,
  },
];

// Releases grouped by major version, newest first; 3.x is the last that runs on Excel 2003.
const releaseGroups = [
  ...new Set(product.olderReleases.map(r => r.version)),
].map(version => product.olderReleases.filter(r => r.version === version));
const excel2003Releases = product.olderReleases.filter(
  r => r.version === '3.x'
);
---

<BaseLayout page={page}>
  <PageHero preTitle={strings.preTitle} title={title} subtitle={product.intro}>
    <a
      class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-slate-400 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-teal-700/80"
      href={product.compare.href}
      aria-label={product.compare.ariaLabel}
    >
      {product.compare.label}
      <Icon name="chevronRight" />
    </a>
  </PageHero>

  <section
    class="mx-auto mt-16 grid max-w-lg grid-cols-1 items-center gap-y-6 px-4 sm:mt-20 md:px-0 lg:max-w-4xl lg:grid-cols-2 lg:gap-y-0"
  >
    <div
      class="rounded-3xl rounded-t-3xl bg-white/60 p-8 ring-1 ring-slate-900/10 sm:p-10 lg:rounded-tr-none lg:rounded-b-none lg:rounded-bl-3xl"
    >
      <h3 class="text-3xl font-semibold text-slate-600">{essential.name}</h3>

      <p class="mt-8 text-base/6 text-slate-600 sm:mt-10">{essential.blurb}</p>
      <a
        href={essential.hrefs.download}
        aria-describedby={essential.name}
        class="mt-8 block rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold ring-1 ring-teal-700 transition duration-300 ring-inset hover:bg-teal-700/80 hover:text-white focus:bg-teal-700 focus:text-white focus:outline-hidden sm:mt-10"
        >{strings.download('Essential')}</a
      >
    </div>

    <div
      class="relative flex flex-col justify-evenly rounded-3xl bg-teal-700 p-8 shadow-2xl ring-1 ring-teal-900/10 sm:p-10 lg:h-[120%]"
    >
      <h3 class="text-4xl/7 font-semibold text-teal-100">{advanced.name}</h3>

      <p class="mt-8 text-lg/6 text-teal-50 sm:mt-10">{advanced.blurb}</p>

      <a
        href={advanced.hrefs.download}
        aria-describedby={advanced.name}
        class="mt-8 block rounded-lg bg-teal-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-teal-600/80 focus:bg-teal-600/80 focus:outline-hidden sm:mt-10"
        >{strings.download('Advanced')}</a
      >
    </div>
  </section>

  <section class="mx-auto max-w-[85rem] px-4 pt-32 pb-16 sm:px-6 lg:px-8">
    <div
      class="mx-auto grid grid-rows-1 content-center divide-y divide-dashed divide-slate-300 lg:mx-0 lg:grid-cols-2 lg:divide-x lg:divide-y-0"
    >
      <div class="py-5 sm:p-5">
        <p
          class="inline-flex gap-x-4 font-medium text-pretty text-slate-700 sm:text-lg/8"
        >
          <Icon name="info" class="size-8" />
          {product.trial.note}
        </p>
      </div>
      <div class="flex flex-col justify-evenly gap-y-5 p-5">
        {
          infoLinks.map(link => (
            <a
              class="group inline-flex w-fit items-center gap-x-2 font-medium text-slate-700 transition duration-300 hover:text-slate-400 focus:outline-hidden"
              href={link.href}
              download={link.download ? link.href.split('/').pop() : undefined}
              aria-label={link.text}
            >
              {link.text}
              <Icon name="chevronRight" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 md:py-14 lg:px-8 lg:py-20"
  >
    <div
      class="grid rounded-3xl bg-teal-300 px-5 py-5 shadow-xl md:grid-cols-2 md:grid-rows-2"
    >
      <div class="py-5 sm:p-5 md:row-span-2 md:content-center">
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {strings.olderReleases}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {strings.olderReleasesIntro}
        </p>

        {
          releaseGroups.map(group => (
            <ul class="mt-6 list-inside list-none px-5 text-slate-700">
              {group.map(release => (
                <li>
                  <a
                    href={release.href}
                    class="transition duration-300 hover:text-slate-400 hover:underline"
                  >
                    {releaseLabel(release)}
                  </a>
                </li>
              ))}
            </ul>
          ))
        }
      </div>

      <div
        class="border-t border-dashed border-slate-400 py-5 sm:p-5 md:content-center md:border-t-0 md:border-l"
      >
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {strings.systemRequirements}
        </h3>
        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {product.systemRequirements}
        </p>
      </div>
      <div
        class="border-t border-dashed border-slate-400 py-5 sm:p-5 md:col-start-2 md:row-start-2 md:content-center md:border-l"
      >
        <h3
          class="text-2xl font-bold tracking-tight text-balance text-slate-800"
        >
          {strings.excel2003}
        </h3>

        <p class="mt-6 text-lg/8 text-pretty text-slate-700">
          {strings.excel2003Note}
        </p>

        <ul class="mt-6 list-inside list-none px-5 text-slate-700">
          {
            excel2003Releases.map(release => (
              <li>
                <a
                  href={release.href}
                  class="transition duration-300 hover:text-slate-400 hover:underline"
                >
                  {releaseLabel(release)}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
