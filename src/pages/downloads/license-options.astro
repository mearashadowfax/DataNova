---
import BaseLayout from '@layout/BaseLayout.astro';
import PageHero from '@common/PageHero.astro';
import Icon from '@ui/icons/Icon.astro';
import type { IconName } from '@ui/icons/icons';
import { describePage } from '@/seo';
import { site, telHref } from '@/site';
import { product } from '@/product';

const { essential, advanced } = product.editions;

const title = `Purchase a license key for the ${site.product}`;
const page = describePage({
  title: 'License Options',
  description: product.intro,
  url: Astro.url,
});

// Page copy
const strings = {
  preTitle: 'Register',
  register: (edition: string) => `Register ${edition}`,
};

// Guarantees
const features = [
  {
    title: 'Our Guarantee',
    description: `We stand by the quality of ${site.brand}. If you're not completely satisfied, we’ll issue a full refund within 30 days of purchase.`,
    className: 'rounded-xl lg:rounded-l-xl lg:rounded-r-none',
  },
  {
    title: 'Lifetime Licensing',
    description: `Purchase once, use forever. Both the ${essential.name} and the ${advanced.name} include perpetual licenses with no ongoing maintenance fees.`,
    className: 'rounded-xl lg:rounded-none',
  },
  {
    title: 'One Year of Free Updates',
    description:
      'Access all software updates free for one year from the purchase date. Afterward, continue receiving updates at a reduced renewal rate.',
    className: 'rounded-xl lg:rounded-r-xl lg:rounded-l-none',
  },
];

// Info Section
const infoSections: {
  title: string | null;
  content: string[];
  className: string;
  icon: IconName | null;
  iconClass?: string;
}[] = [
  {
    title: 'System Requirements',
    content: [
      product.systemRequirements,
      `The ${product.subscription.name} also requires an active internet connection.`,
    ],
    className: 'md:row-span-2 md:content-center py-5 sm:p-5',
    icon: null,
  },
  {
    title: null,
    content: [
      `Every installation package includes the full ${site.product} software, sample workbooks, and detailed user documentation. For enterprise solutions, bulk licensing, or invoicing inquiries, reach out to us at <a href='mailto:${site.salesEmail}' aria-label='Sales email' class="hover:text-slate-400 transition-colors duration-300"
>${site.salesEmail}</a> or call <a href='${telHref(site.phone)}' aria-label='Contact number' class="hover:text-slate-400 transition-colors duration-300"
>${site.phone}</a>. Discounts for academic and non-profit organizations are available.`,
    ],
    className:
      'md:content-center md:border-l border-t md:border-t-0 border-dashed border-slate-400 py-5 sm:p-5',
    icon: 'info',
    iconClass: 'shrink-0 size-8 text-slate-600 mt-6',
  },
  {
    title: 'Partners & Resellers',
    content: [
      `${site.name} is proud to collaborate with top-tier software resellers worldwide. Contact us to locate an authorized reseller or invite your preferred reseller to join our partner network.`,
    ],
    className:
      'md:col-start-2 md:row-start-2 md:content-center md:border-l border-t border-dashed border-slate-400 py-5 sm:p-5',
    icon: null,
  },
];
---

<BaseLayout page={page}>
  <PageHero
    preTitle={strings.preTitle}
    title={title}
    subtitle={product.intro}
    width="xl"
  >
    <a
      href={product.compare.href}
      class="group mt-5 inline-flex items-center justify-center gap-x-2 text-center font-medium text-slate-700 shadow-lg shadow-transparent transition duration-300 hover:text-slate-400 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-teal-700/80"
      aria-label={product.compare.ariaLabel}
    >
      {product.compare.label}
      <Icon name="chevronRight" />
    </a>
  </PageHero>

  <section
    class="mx-auto mt-16 grid max-w-lg grid-cols-1 items-center gap-y-6 px-4 sm:mt-20 md:px-0 lg:max-w-4xl lg:grid-cols-2 lg:gap-y-0"
  >
    <div
      class="rounded-3xl rounded-t-3xl bg-white/60 p-8 ring-1 ring-slate-900/10 sm:p-10 lg:rounded-tr-none lg:rounded-b-none lg:rounded-bl-3xl"
    >
      <h3 class="text-base/7 font-semibold text-slate-600">{essential.name}</h3>
      <p class="mt-4 flex items-baseline gap-x-2">
        <span class="text-5xl font-semibold tracking-tight text-slate-900">
          {essential.price.amount}
        </span>
        <span class="text-base text-slate-500">{essential.price.per}</span>
      </p>
      <p class="mt-6 text-base font-medium text-slate-600">
        {essential.audience}
      </p>
      <p class="mt-8 text-base/6 text-slate-600 sm:mt-10">{essential.blurb}</p>
      <a
        href={essential.hrefs.register}
        aria-describedby={essential.name}
        class="mt-8 block rounded-lg px-3.5 py-2.5 text-center text-sm font-semibold ring-1 ring-teal-700 transition duration-300 ring-inset hover:bg-teal-700/80 hover:text-white focus:bg-teal-700 focus:text-white focus:outline-hidden sm:mt-10"
      >
        {strings.register('Essential')}
      </a>
    </div>

    <div
      class="relative flex flex-col justify-evenly rounded-3xl bg-teal-700 p-8 shadow-2xl ring-1 ring-teal-900/10 sm:p-10 lg:h-[120%]"
    >
      <h3 class="text-base/7 font-semibold text-teal-100">{advanced.name}</h3>
      <p class="mt-4 flex items-baseline gap-x-2">
        <span class="text-5xl font-semibold tracking-tight text-white">
          {advanced.price.amount}
        </span>
        <span class="text-base text-teal-200">{advanced.price.per}</span>
      </p>
      <p class="mt-6 text-base font-medium text-teal-50 lg:mt-0">
        {advanced.audience}
      </p>
      <p class="mt-8 text-base/6 text-teal-50 sm:mt-10">{advanced.blurb}</p>

      <a
        href={advanced.hrefs.register}
        aria-describedby={advanced.name}
        class="mt-8 block rounded-lg bg-teal-600 px-3.5 py-2.5 text-center text-sm font-semibold text-white shadow-xs transition-colors duration-300 hover:bg-teal-600/80 focus:bg-teal-600/80 focus:outline-hidden sm:mt-10"
      >
        {strings.register('Advanced')}
      </a>
    </div>
  </section>

  <section class="py-24 sm:py-40">
    <div class="mx-auto max-w-7xl px-6 lg:px-8">
      <dl class="grid grid-cols-1 gap-x-3 gap-y-16 text-center lg:grid-cols-3">
        {
          features.map(({ title, description, className }) => (
            <div class={`flex flex-col gap-y-4 bg-teal-100 p-10 ${className}`}>
              <dt class="text-base/7 text-slate-600">{description}</dt>
              <dd class="order-first text-3xl font-medium tracking-tight text-slate-900">
                <h3>{title}</h3>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section
    class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 md:pb-14 lg:px-8 lg:pb-20"
  >
    <div
      class="relative grid overflow-hidden rounded-3xl bg-teal-300 px-5 py-5 shadow-xl md:grid-cols-2 md:grid-rows-2"
    >
      {
        infoSections.map(({ title, content, className, icon, iconClass }) => (
          <div class={className}>
            {title && (
              <h3 class="text-2xl font-bold tracking-tight text-balance text-slate-800">
                {title}
              </h3>
            )}
            {icon && <Icon name={icon} class={iconClass} />}

            {content.map(paragraph => (
              <p class="mt-6 text-lg/8 text-pretty text-slate-700">
                <Fragment set:html={paragraph} />
              </p>
            ))}
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
